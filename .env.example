# ==============================================================================
# KONFIGURASI ENVIRONMENT WEBSITE KAMPUNG INGGRIS SAPEN
# Salin file ini menjadi .env.local saat ingin menghubungkan Supabase & Midtrans
# Jika dikosongkan, sistem otomatis berjalan dalam Mode Lokal/Demo penuh!
# ==============================================================================

# 1. SUPABASE (Database, Auth, Private Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. KEAMANAN SESSION & SIGNED URL GAMBAR FLIPBOOK
APP_SESSION_SECRET=kampung-inggris-sapen-super-secret-key-2026

# 3. AKUN ADMIN DEFAULT (2 Role Admin: Pengurus & Developer)
ADMIN_PENGURUS_EMAIL=pengurus@kampungsapen.id
ADMIN_PENGURUS_PASSWORD=sapen2026
ADMIN_DEVELOPER_EMAIL=dev@kampungsapen.id
ADMIN_DEVELOPER_PASSWORD=devsapen2026

# 4. MIDTRANS PAYMENT GATEWAY (QRIS & Virtual Account)
# Gunakan Sandbox untuk testing atau Production saat live
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
