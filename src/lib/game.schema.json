{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kampungsapen.id/schemas/game-draft.schema.json",
  "title": "Sapen English Game Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "template", "level", "topic", "language", "status", "settings", "items"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "template": { "enum": ["multiple-choice-quiz", "drag-and-sort", "listen-and-choose", "sentence-builder", "matching", "word-bank", "word-search"] },
    "level": { "enum": ["A1", "A2", "B1", "B2"] },
    "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "language": { "enum": ["id", "en", "id-en"] },
    "status": { "enum": ["draft", "published", "session", "independent"] },
    "destination": { "enum": ["public", "session", "independent"] },
    "plays": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hearts", "timeLimitSec", "randomizeQuestions", "randomizeOptions", "mode", "theme"],
      "properties": {
        "hearts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeLimitSec": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "randomizeQuestions": { "type": "boolean" },
        "randomizeOptions": { "type": "boolean" },
        "mode": { "enum": ["solo", "class", "both"] },
        "theme": { "enum": ["forest", "tomato", "saffron", "ocean"] },
        "mascot": { "type": "string", "maxLength": 40 }
      }
    },
    "items": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/definitions/item" } }
  },
  "allOf": [
    { "if": { "properties": { "template": { "const": "multiple-choice-quiz" } } }, "then": { "properties": { "items": { "items": { "required": ["options", "correctIndex"] } } } } },
    { "if": { "properties": { "template": { "const": "drag-and-sort" } } }, "then": { "properties": { "items": { "items": { "required": ["categories", "sortItems"] } } } } },
    { "if": { "properties": { "template": { "const": "listen-and-choose" } } }, "then": { "properties": { "items": { "items": { "required": ["audioText", "options", "correctIndex"] } } } } },
    { "if": { "properties": { "template": { "const": "sentence-builder" } } }, "then": { "properties": { "items": { "items": { "required": ["words"] } } } } },
    { "if": { "properties": { "template": { "const": "matching" } } }, "then": { "properties": { "items": { "items": { "required": ["pairs"] } } } } },
    { "if": { "properties": { "template": { "const": "word-bank" } } }, "then": { "properties": { "items": { "items": { "required": ["vocabulary"] } } } } },
    { "if": { "properties": { "template": { "const": "word-search" } } }, "then": { "properties": { "items": { "items": { "required": ["words", "grid"] } } } } }
  ],
  "definitions": {
    "optionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1, "maxLength": 200 } }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 500 },
        "explanation": { "type": "string", "maxLength": 1000 },
    "options": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/definitions/optionItem" } },
        "correctIndex": { "type": "integer", "minimum": 0, "maximum": 5 },
        "audioText": { "type": "string", "maxLength": 500 },
        "answer": { "type": "string", "maxLength": 500 },
        "categories": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } } } },
        "sortItems": { "type": "array", "minItems": 2, "maxItems": 40, "items": { "type": "object", "additionalProperties": false, "required": ["text", "categoryId"], "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 100 }, "categoryId": { "type": "string", "minLength": 1 } } } },
        "words": { "type": "array", "minItems": 2, "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "pairs": { "type": "array", "minItems": 2, "maxItems": 30, "items": { "type": "object", "additionalProperties": false, "required": ["left", "right"], "properties": { "left": { "type": "string", "minLength": 1, "maxLength": 100 }, "right": { "type": "string", "minLength": 1, "maxLength": 100 } } } },
        "vocabulary": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "additionalProperties": false, "required": ["term", "translation"], "properties": { "term": { "type": "string", "minLength": 1 }, "translation": { "type": "string", "minLength": 1 }, "pronunciation": { "type": "string" }, "example": { "type": "string" } } } },
        "grid": { "type": "array", "minItems": 3, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 20 } }
      }
    }
  }
}
